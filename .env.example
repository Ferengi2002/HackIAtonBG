# ==============================================================================
# CONFIGURACION DE AZURE AI FOUNDRY (BANCO GUAYAQUIL - COPILOTO RIESGO)
# ==============================================================================
# Copia este archivo a '.env' y completa tu clave de API:

# Punto de conexion de tu proyecto en Azure AI Foundry
AZURE_OPENAI_ENDPOINT=https://jrengifo-6526-resource.services.ai.azure.com/openai/v1

# Clave de API obtenida en el portal de Azure AI Foundry
AZURE_OPENAI_API_KEY=tu_azure_api_key_aqui

# Nombre del deployment (ej: gpt-4o)
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Version de la API
AZURE_OPENAI_API_VERSION=2024-10-21

# Ruta del modelo tabular LightGBM
BG_RISK_MODEL_PATH=models/bg_risk_lightgbm.joblib

