# ==============================================================================
# .gitignore - Banco Guayaquil Copiloto de Salud Financiera
# ==============================================================================

# 1. Variables de entorno y secretos bancarios (CRITICO: NUNCA SUBIR)
.env
*.env
*.pem
*.key
*.pfx

# 2. Archivos comprimidos y binarios de empaquetado temporal
*.zip
*.tar.gz
*.rar
*.7z

# 3. Python Cache y Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
test-results.xml
coverage.xml

# 4. Entornos virtuales
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 5. Jupyter Notebooks Checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# 6. Datos temporales y datos crudos pesados
data/raw/
*.log

# 7. Configuraciones de IDE y Editores locales
.vscode/
.idea/
*.swp
*.swo
*~

# 8. Archivos del Sistema Operativo
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# 9. Presentaciones y Assets de Diapositivas (PowerPoint / Pitch)
*.pptx
*.ppt
*.ppsx
*.pps
presentation_assets/
scripts/*presentation*.py
scripts/*pitch*.py
scripts/*slide*.py
scripts/*inspect*.py
scripts/*icon*.py
scripts/*emf*.py
scripts/*badge*.py
scripts/*color*.py
scripts/check_image*.py
scripts/get_azure_logo.py
scripts/build_diagram_deck.py
scripts/map_slide_media.py

# 10. Archivos temporales y basura del sistema
*.tmp
*.temp
*.bak
*.orig
.cache/
